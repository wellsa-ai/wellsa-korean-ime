<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.wellsa.koreanime" android:versionCode="5" android:versionName="0.3.2">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="35" />
    <!-- No permissions requested, no network. -->
    <application android:label="Wellsa Korean IME" android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:debuggable="false">
        <activity android:name=".MainActivity" android:exported="true" android:label="Wellsa Korean IME"
                  android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".TextIme" android:label="Wellsa Korean IME" android:exported="true"
                 android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
        <!-- On API 34+ even `am broadcast` from shell does not reach a non-exported receiver. So the receiver is exported but protected by the
             signature-level permission INJECT_EVENTS, which ordinary apps cannot obtain (held by shell/system). -->
        <receiver android:name=".InputReceiver" android:exported="true" android:permission="android.permission.INJECT_EVENTS">
            <intent-filter><action android:name="ai.wellsa.koreanime.COMMIT" /></intent-filter>
        </receiver>
    </application>
</manifest>
